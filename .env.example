# === API de Anthropic (Claude) ===
# Obtén tu clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a utilizar (por defecto se recomienda claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# === Servidor ===
# Puerto donde correrá el backend Express
PORT=3000

# Orígenes permitidos para CORS, separados por coma.
# Ejemplo: https://www.laoccidental.com,https://laoccidental.com
ALLOWED_ORIGINS=http://localhost:3000

# === Límite de peticiones (rate limiting) ===
# Máximo de mensajes por IP en la ventana de tiempo (ms) definida abajo
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# === Personalización del asistente ===
COMPANY_NAME="La Occidental C.A. de Seguros"
ASSISTANT_NAME=Lucy
SUPPORT_EMAIL=info@laoccidental.com
SUPPORT_PHONE="+58 261-000-0000"
# Línea de siniestros/emergencias (atención 24/7)
CLAIMS_PHONE="0212-6204444"

# === Panel de administración (/admin) ===
# Usuario fijo: "admin". Define aquí su contraseña — es OBLIGATORIA para poder
# iniciar sesión en el panel; sin ella, /admin queda deshabilitado.
ADMIN_PASSWORD=cambia-esta-contraseña

# Duración de la sesión del panel en milisegundos (por defecto 8 horas).
# Las sesiones viven en memoria: se cierran todas si el servidor se reinicia.
ADMIN_SESSION_TTL_MS=28800000

# Ruta del archivo donde se guardan las conversaciones (por defecto conversations.json
# en la raíz del proyecto). Contiene el texto completo de las conversaciones de los
# usuarios — trátalo como información sensible, no lo subas a un repositorio público.
CONVERSATIONS_FILE=conversations.json

# Ruta del archivo de configuración del cotizador automático (tarifas RCV, tasas HCM,
# tipos de bien patrimoniales, textos). Editable desde el panel /admin.
QUOTER_CONFIG_FILE=quoter-config.json

# Ruta del archivo donde se guarda la memoria persistente de clientes (perfiles
# identificados por cédula: nombre, pólizas, temas de interés, notas internas, etc.
# — por defecto data/clientes.json). Contiene datos personales — trátalo como
# información sensible, no lo subas a un repositorio público.
CLIENTES_FILE=data/clientes.json

# === Base de datos de pólizas (services/polizas.service.js) ===
# Ruta del archivo JSON con los datos de pólizas — mientras no exista un sistema
# externo. Datos de ejemplo/fixture (no son clientes reales), sí se versiona.
POLIZAS_FILE=data/polizas.json

# URL base de una API REST real de pólizas — déjala vacía para usar el archivo local
# de arriba (recomendado mientras no exista un sistema externo). Si la defines, el
# servicio deja de leer POLIZAS_FILE y en su lugar consulta:
#   GET {POLIZAS_API_URL}/polizas?cedula=<cedula>   (pólizas de un cliente)
#   GET {POLIZAS_API_URL}/polizas/<numero>          (una póliza puntual)
# Ajusta services/polizas.service.js si tu API real tiene un contrato distinto.
POLIZAS_API_URL=

# === Gestión de siniestros (services/siniestros.service.js) ===
# Ruta del archivo JSON con los siniestros — mientras no exista un sistema externo.
# Datos de ejemplo/fixture (no son casos reales), sí se versiona.
SINIESTROS_FILE=data/siniestros.json

# URL base de una API REST real de siniestros — déjala vacía para usar el archivo local
# de arriba (recomendado mientras no exista un sistema externo). Si la defines, el
# servicio deja de leer/escribir SINIESTROS_FILE y en su lugar consulta:
#   GET   {SINIESTROS_API_URL}/siniestros                  (todos, para /admin)
#   GET   {SINIESTROS_API_URL}/siniestros?cedula=<cedula>   (los de un cliente)
#   GET   {SINIESTROS_API_URL}/siniestros/<numero>          (uno puntual)
#   POST  {SINIESTROS_API_URL}/siniestros                   (abrir uno nuevo)
#   PATCH {SINIESTROS_API_URL}/siniestros/<numero>          (actualizar uno existente)
# Ajusta services/siniestros.service.js si tu API real tiene un contrato distinto.
SINIESTROS_API_URL=

# === Portal de corredores (/corredor) — ver services/corredores.service.js ===
# Clave secreta para firmar los tokens JWT del portal — OBLIGATORIA para que el portal
# funcione; sin ella, /corredor y /api/corredor/* quedan deshabilitados (igual criterio
# que ADMIN_PASSWORD para /admin). Usa una cadena larga y aleatoria en producción, p. ej.
# generada con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión del portal de corredores, en milisegundos (por defecto 8 horas).
# El token vive en el navegador (localStorage) — no hay sesiones en memoria que revocar
# aquí como en /admin; expira solo.
CORREDOR_SESSION_TTL_MS=28800000

# Cada cuánto (ms) se revisan las pólizas de cada corredor conectado por si alguna cruzó
# el umbral de "vence en 7 días" (notificación en tiempo real) — por defecto 10 minutos.
CORREDOR_CHEQUEO_VENCIMIENTOS_MS=600000

# Ruta del archivo JSON con las cuentas de corredor (email/contraseña, comisión). Datos
# de ejemplo/fixture — contraseñas de DEMO documentadas en el README, no reales —, sí se
# versiona.
CORREDORES_FILE=data/corredores.json

# Ruta del archivo JSON con las solicitudes de emisión enviadas desde el portal.
# Contiene datos reales de clientes una vez que se usa — información sensible, no la
# subas a un repositorio público.
EMISIONES_FILE=data/emisiones.json

# === Adjuntos (fotos de siniestros/vehículos, documentos) ===
# Carpeta donde se guardan los archivos subidos por los usuarios (por defecto ./uploads).
UPLOADS_DIR=uploads

# Tamaño máximo por archivo, en megabytes.
MAX_UPLOAD_SIZE_MB=5

# === Notas de voz — transcripción con Whisper (API de OpenAI) ===
# Independiente de ANTHROPIC_API_KEY: Claude no transcribe audio, así que la
# conversión de voz a texto (widget web y WhatsApp) usa la API de OpenAI.
# Consíguela en https://platform.openai.com/api-keys — sin esta clave, las notas de
# voz se siguen guardando pero no se transcriben (el usuario recibe un aviso).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Respuestas de Lucy en audio (texto-a-voz) ===
# Proveedor PREFERIDO: ElevenLabs (voz más natural). Consigue tu API key en
# https://elevenlabs.io/app/settings/api-keys y el ID de una voz femenina en español
# (p. ej. busca "Rachel" o "Valentina" en https://elevenlabs.io/app/voice-library) en
# https://elevenlabs.io/app/voice-lab — ambas variables son necesarias para usarlo.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Si ElevenLabs no está configurado (o falla en tiempo real), Lucy cae automáticamente
# a la API de texto-a-voz de OpenAI (modelo "tts-1", voz "nova") — reutiliza la misma
# OPENAI_API_KEY de arriba, no hace falta configurarla dos veces. Si NINGUNO de los dos
# proveedores está disponible, Lucy simplemente no responde con audio (solo con texto).

# === WhatsApp Business (vía Twilio) — ver WHATSAPP_SETUP.md ===
# Datos de tu cuenta de Twilio (consola: https://console.twilio.com).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token-de-twilio

# Número de WhatsApp de Twilio, CON el prefijo "whatsapp:" incluido.
# Sandbox de pruebas: normalmente "whatsapp:+14155238886".
# Producción: el número de WhatsApp Business que hayas dado de alta en Twilio.
TWILIO_WHATSAPP_NUMBER="whatsapp:+58412xxxxxxx"

# URL pública HTTPS de este servidor (dominio real en producción, o la URL de ngrok
# en desarrollo). Se usa para validar de forma confiable la firma de las peticiones
# de Twilio; si la dejas vacía, se intenta deducir de la propia petición (funciona
# en despliegues simples sin proxy/balanceador delante).
PUBLIC_BASE_URL=
