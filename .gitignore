node_modules/
.env
npm-debug.log*
*.log
.DS_Store

# Datos de conversaciones de usuarios reales (información sensible) — no versionar.
conversations.json

# Archivos adjuntos por los usuarios (fotos de siniestros, documentos con datos
# personales) y su índice — información sensible, no versionar.
/uploads/

# Perfiles de clientes (memoria persistente: cédula, teléfono, correo, notas
# internas) — información sensible, no versionar. (data/polizas.json y
# data/siniestros.json SÍ se versionan — son data de ejemplo/fixture, no información
# real de clientes.)
/data/clientes.json

# Solicitudes de emisión de póliza enviadas por corredores desde /corredor/cotizar —
# contienen datos reales de clientes (nombre, cédula, vehículo, etc.), información
# sensible, no versionar. (data/corredores.json SÍ se versiona — son cuentas de
# corredores de ejemplo/fixture con contraseñas de demo documentadas en el README,
# no credenciales reales.)
/data/emisiones.json

# Preguntas que Lucy no respondió bien (motor de inteligencia) — puede contener texto
# real de clientes, no versionar. Estado operativo de las tareas programadas
# (recordatorios de pólizas ya enviados) — no es data de ejemplo, no versionar.
/data/gaps-conocimiento.json
/data/notificaciones-programadas.json

# Estado interno de la sesión de Claude Code (lock de tareas programadas) — no es
# parte del proyecto, no versionar.
.claude/scheduled_tasks.lock
